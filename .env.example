# Rosepsy - تنظیمات محیط (بند ۱۳.۲: فایل واقعی خارج از مخزن و با مجوز محدود)
# این فایل را به .env کپی کنید و مقادیر CHANGE_ME را تصادفی کنید

# --- PostgreSQL ---
POSTGRES_USER=rosepsy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=rosepsy

# --- Backend ---
DATABASE_URL=postgresql+psycopg://rosepsy:CHANGE_ME_STRONG_PASSWORD@db:5432/rosepsy
# development فقط برای تست محلی HTTP؛ در عملیات: production (نیازمند HTTPS)
ENVIRONMENT=development

# کلید امضای Access Token - حتماً تصادفی (مثال تولید: openssl rand -hex 32)
AUTH_SECRET_KEY=CHANGE_ME_RANDOM_HEX64

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ACTIVATION_TOKEN_EXPIRE_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# --- فاز ۲۷ - B39-plus: آنتی‌ویروس واقعی (ClamAV) ---
# در docker compose مقدار CLAMAV_HOST=clamav است؛ نصب بومی: خالی بگذارید تا از قواعد پایه استفاده شود
CLAMAV_ENABLED=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
STRIP_IMAGE_METADATA=true

# --- فاز ۲۷ - B12+: خروجی اعلان به ایمیل (تصمیم D04 - SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=rosepsy@clinic.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATIONS_EMAIL_ENABLED=true

# --- فاز ۲۹ - B10/B11: سفارش و پرداخت (تصمیم D02: درگاه پلاگین‌پذیر) ---
# sandbox = شبیه‌ساز توسعه/آزمون؛ zarinpal = درگاه پیشنهادی تولید
PAYMENT_GATEWAY=sandbox

# دستیار هوشمند پنل (فاز ۷۰) - بدون کلید: حالت اقدام‌محور (قاعده‌محور + ابزارهای واقعی)
# برای حلقهٔ عامل LLM سازگار با DeepSeek/GLM/OpenAI/vLLM مقدار دهید:
AI_PROVIDER=rule
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=deepseek-chat
AI_AGENT_MAX_STEPS=4
# آدرس عمومی سامانه برای ساخت callback درگاه واقعی
PUBLIC_BASE_URL=http://localhost:5173
# زرین‌پال REST v4؛ خالی بودن merchant یعنی درگاه غیرفعال
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# --- فاز ۳۶ - B28: یکپارچه‌سازی‌های بیرونی — سرویس پیامک پلاگین‌پذیر ---
# log = توسعه/آزمون بدون کلید؛ kavenegar/smsir فقط با کلید (نبود کلید → fallback به log)
SMS_ENABLED=false
SMS_PROVIDER=log
# کلید سرویس پیامک؛ هرگز به کلاینت/لاگ نمی‌رود
SMS_API_KEY=
SMS_SENDER=
SMS_MAX_ATTEMPTS=5
# کپی اعلان‌های درون‌برنامه‌ای به پیامک (فقط گیرنده دارای موبایل)
NOTIFICATIONS_SMS_ENABLED=true

# --- فاز ۳۷/۳۸ - ADR-04: Object Storage پلاگین‌پذیر (MinIO/S3) ---
# فاز ۴۰ - گام ۳ طرح مهاجرت: سوییچ به s3 انجام شد؛ نبود کلیدها یا خطای سرویس
# → fallback شفاف به local (سپر خرابی). برای بازگشت کامل: STORAGE_BACKEND=local
# پیش‌نیاز s3 در عملیات: اجرای MinIO با پروفایل storage + اجرای اسکریپت مهاجرت فایل‌های موجود
#   docker compose --profile storage up -d
#   docker compose run --rm api python scripts/migrate_files_to_s3.py --loop
STORAGE_BACKEND=s3
# در docker compose مقدار این متغیر خودکار به http://minio:9000 تنظیم می‌شود
S3_ENDPOINT_URL=
S3_BUCKET=rosepsy-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CONNECT_TIMEOUT_SECONDS=3
# فاز ۴۱ - گام ۴ طرح ADR-04 (تسویه volume محلی): پس از صفر شدن ردیف‌های local
# (گزارش پاک اسکریپت زیر) می‌توانید volume را فقط-خواندنی کنید:
#   docker compose run --rm api python scripts/settle_local_storage.py --dry-run
#   docker compose run --rm api python scripts/settle_local_storage.py --enforce --loop
# فاز ۴۲ - اجرای عملیاتی گام ۴ (readonly v1 + :ro volume) با یک دستور:
#   docker compose -f compose.yml -f compose.settled.yml up -d api
#   (پیش‌نیازها و راه بازگشت، سربرگ compose.settled.yml)

# --- فاز ۴۲ - ADR-05 گام ۳: Idempotency-Key واقعی عملیات مالی ---
# رزرو بدون پاسخ (سقوط سرور بین دو فاز) پس از این TTL کهنه و جایگزین می‌شود
IDEMPOTENCY_PENDING_TTL_SECONDS=600
# عمر نگهداری ردیف‌های ثبت‌شده (طرح ADR-05: پاک‌سازی ۲۴ ساعته — purge ادمین/تنبل)
IDEMPOTENCY_RETENTION_HOURS=24
# حداقل فاصله پاک‌سازی تنبل خودکار داخل reserve (بدون نیاز به beat)
IDEMPOTENCY_LAZY_PURGE_INTERVAL_SECONDS=3600

# --- فاز ۳۸ - گام ۱ طرح مهاجرت ADR-04: سرویس MinIO در compose (پروفایل storage) ---
# اجرا: docker compose --profile storage up -d
MINIO_ROOT_USER=rosepsy
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- فاز ۴۱ - ADR-03 گام ۴: انقضای اعلام‌شده v1 ---
# warn (پیش‌فرض): فقط هدرهای Deprecation/Sunset/Warning روی پاسخ‌های /api/v1
# readonly: کلید اضطراری چرخه حذف — متدهای نوشتاری v1 با 410 رد می‌شوند
# (فعال‌سازی فقط پس از یک چرخه انتشار کامل با warn و پایش مصرف‌کننده جامانده)
V1_DEPRECATION_MODE=warn
# تاریخ پیشنهادی قطع v1 (YYYY-MM-DD) — در هدر Sunset به شکل HTTP-date می‌رود
V1_SUNSET_DATE=2027-04-20


# --- فاز ۴۳ - گام‌های ۱–۲ ADR-05: سقف نرخ سراسری Redis ---
# در docker compose خودکار redis://redis:6379/0 تنظیم می‌شود؛ خالی = غیرفعال
# نبود Redis/خطای آن → fail-open با هشدار (بند ۶ سند: دسترس‌پذیری مقدم بر سقف‌گیری دقیق)
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
# سقف پیش‌فرض: ناشناس (کلید route,ip) و احرازشده (کلید route,user_id)
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=60
# override per-route: JSON مثل {"POST /api/v1/auth/login": 10, "GET /api/v1/public/*": 300}
# کلید: «METHOD مسیر» (با پیشوند نسخه یا بدون آن) یا «* مسیر»؛ "*" پایانی = تطبیق پیشوندی؛
# شناسه‌های مسیر (عدد/UUID/هش) به :id فروریز می‌شوند
RATE_LIMIT_OVERRIDES=
# user_idهای بی‌سقف (توکن سرویس/مشتری اداری SLA-دار) با کاما جدا می‌شوند
RATE_LIMIT_WHITELIST_USER_IDS=
# نرخ نمونه‌برداری ثبت ۴۲۹ در audit (۱.۰ = همیشه؛ کمتر = کنترل سیل نوشتن در حمله)
RATE_LIMIT_AUDIT_SAMPLE_RATE=0.2
